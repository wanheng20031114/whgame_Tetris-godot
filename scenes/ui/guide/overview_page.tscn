[gd_scene format=3]

[node name="GuideOverviewPage" type="ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="PageMargin" type="MarginContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_right = 14

[node name="Page" type="VBoxContainer" parent="PageMargin"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 18

[node name="HeroPanel" type="PanelContainer" parent="PageMargin/Page"]
layout_mode = 2

[node name="HeroMargin" type="MarginContainer" parent="PageMargin/Page/HeroPanel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 22
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 22

[node name="HeroBox" type="VBoxContainer" parent="PageMargin/Page/HeroPanel/HeroMargin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="HeroTitle" type="Label" parent="PageMargin/Page/HeroPanel/HeroMargin/HeroBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.058824, 0.121569, 0.270588, 1)
theme_override_font_sizes/font_size = 30
text = "先看收益，再练操作"

[node name="HeroBody" type="Label" parent="PageMargin/Page/HeroPanel/HeroMargin/HeroBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.278431, 0.333333, 0.411765, 1)
theme_override_font_sizes/font_size = 15
text = "从基础规则进入固定场景，按真实操作理解每一种技巧。"
autowrap_mode = 3

[node name="PathPanel" type="PanelContainer" parent="PageMargin/Page"]
layout_mode = 2

[node name="PathMargin" type="MarginContainer" parent="PageMargin/Page/PathPanel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="PathBox" type="HBoxContainer" parent="PageMargin/Page/PathPanel/PathMargin"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="CardsPanel" type="PanelContainer" parent="PageMargin/Page"]
layout_mode = 2

[node name="CardsMargin" type="MarginContainer" parent="PageMargin/Page/CardsPanel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="CardsGrid" type="GridContainer" parent="PageMargin/Page/CardsPanel/CardsMargin"]
unique_name_in_owner = true
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 14
