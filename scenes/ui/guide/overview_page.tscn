[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/mode_card.gd" id="1_card"]

[node name="GuideOverviewPage" type="ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="PageMargin" type="MarginContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 4
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 20

[node name="Page" type="VBoxContainer" parent="PageMargin"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 18

[node name="HeroPanel" type="PanelContainer" parent="PageMargin/Page"]
layout_mode = 2
script = ExtResource("1_card")
hue = "violet"
show_index = false
show_arrow = false

[node name="HeroMargin" type="MarginContainer" parent="PageMargin/Page/HeroPanel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 22
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 22

[node name="HeroBox" type="VBoxContainer" parent="PageMargin/Page/HeroPanel/HeroMargin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="HeroTitle" type="Label" parent="PageMargin/Page/HeroPanel/HeroMargin/HeroBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 34
text = "先看收益，再练操作"

[node name="HeroBody" type="Label" parent="PageMargin/Page/HeroPanel/HeroMargin/HeroBox"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 15
text = "从基础规则进入固定场景，按真实操作理解每一种技巧。"
autowrap_mode = 3

[node name="PathPanel" type="PanelContainer" parent="PageMargin/Page"]
layout_mode = 2

[node name="PathMargin" type="MarginContainer" parent="PageMargin/Page/PathPanel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="PathBox" type="HFlowContainer" parent="PageMargin/Page/PathPanel/PathMargin"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="CardsPanel" type="PanelContainer" parent="PageMargin/Page"]
layout_mode = 2

[node name="CardsMargin" type="MarginContainer" parent="PageMargin/Page/CardsPanel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="CardsBox" type="VBoxContainer" parent="PageMargin/Page/CardsPanel/CardsMargin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="BasicsTitle" type="Label" parent="PageMargin/Page/CardsPanel/CardsMargin/CardsBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "基础知识"

[node name="BasicsGrid" type="GridContainer" parent="PageMargin/Page/CardsPanel/CardsMargin/CardsBox"]
unique_name_in_owner = true
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 14

[node name="LearningTitle" type="Label" parent="PageMargin/Page/CardsPanel/CardsMargin/CardsBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "学习章节"

[node name="CardsGrid" type="GridContainer" parent="PageMargin/Page/CardsPanel/CardsMargin/CardsBox"]
unique_name_in_owner = true
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 14
