[gd_scene format=3]

[node name="HistoryRow" type="PanelContainer"]
size_flags_horizontal = 3
theme_type_variation = &"RowPanel"

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Date" type="Label" parent="Content/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 14
text_overrun_behavior = 3

[node name="Toggle" type="Button" parent="Content/Header"]
custom_minimum_size = Vector2(36, 32)
layout_mode = 2
theme_type_variation = &"GhostButton"
text = "▾"

[node name="Metrics" type="HFlowContainer" parent="Content"]
layout_mode = 2
theme_override_constants/h_separation = 18
theme_override_constants/v_separation = 6

[node name="Score" type="Label" parent="Content/Metrics"]
layout_mode = 2
theme_type_variation = &"ValueLabel"
theme_override_font_sizes/font_size = 17

[node name="Lines" type="Label" parent="Content/Metrics"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 16

[node name="PPS" type="Label" parent="Content/Metrics"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 16

[node name="Duration" type="Label" parent="Content/Metrics"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 16

[node name="Detail" type="Label" parent="Content"]
visible = false
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
