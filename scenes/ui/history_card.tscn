[gd_scene format=3]

[node name="HistoryCard" type="PanelContainer"]
theme_type_variation = &"CardPanel"

[node name="HistoryVBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HistoryTitle" type="Label" parent="HistoryVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "RECENT HISTORY"

[node name="Sep3" type="HSeparator" parent="HistoryVBox"]
layout_mode = 2

[node name="HistoryContainer" type="VBoxContainer" parent="HistoryVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4
